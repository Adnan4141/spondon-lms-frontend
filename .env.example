# Copy to `.env.local` (or `.env`) for local dev. Never commit real secrets.
# See: https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# Base URL of the backend API, including the `/api` path prefix.
# Example local:  http://localhost:5000/api
# Example prod:   https://your-api-domain.com/api
#
# When this points at localhost, the browser uses a same-origin `/api` proxy
# (see next.config.ts rewrites) so phones on your LAN can reach the backend.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Optional: force the browser to use the `/api` proxy even with a remote API URL.
# NEXT_PUBLIC_USE_API_PROXY=true

# Optional: server-side fetch target (defaults to NEXT_PUBLIC_API_URL).
# API_URL=http://localhost:5000/api

# Optional: backend origin for Next.js rewrites (defaults from NEXT_PUBLIC_API_URL).
# BACKEND_URL=http://localhost:5000

# Cloudflare Turnstile (login page)
# Test site key (always passes): 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
